{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kaggle-instance-manager",
  "version": "0.2.0",
  "identifier": "com.hamimmahmud0.kaggleinstancemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kaggle Instance Manager",
        "label": "main",
        "width": 1000,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/kaggle_tunnel": "kaggle_tunnel"
    },
    "icon": [
      "icons/icon.svg",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "python3",
          "python3-aiohttp",
          "python3-kaggle-tunnel",
          "sshpass",
          "openssh-client"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
